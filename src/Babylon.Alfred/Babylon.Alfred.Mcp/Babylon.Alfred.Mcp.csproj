<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Babylon.Alfred.Api\Babylon.Alfred.Api.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\.ai\mcp-context.md" Link="mcp-context.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup>
        <_ApiAppSettingsPath>$([System.IO.Path]::Combine('Babylon.Alfred.Api', 'appsettings'))</_ApiAppSettingsPath>
    </PropertyGroup>

    <Target Name="ExcludeApiAppSettingsFromOutput" AfterTargets="GetCopyToOutputDirectoryItems">
        <ItemGroup>
            <_TransitiveItemsToCopyToOutputDirectory Remove="@(_TransitiveItemsToCopyToOutputDirectory)" Condition="$([System.String]::Copy('%(_TransitiveItemsToCopyToOutputDirectory.FullPath)').Contains('$(_ApiAppSettingsPath)'))" />
        </ItemGroup>
    </Target>

    <Target Name="ExcludeApiAppSettingsFromPublish" AfterTargets="_ComputeCopyToPublishDirectoryItems">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('$(_ApiAppSettingsPath)'))" />
        </ItemGroup>
    </Target>

</Project>
